{
  "name": "@pascapone/dsh-muse-code",
  "version": "0.1.0",
  "description": "One-shot Muse Code subagent provider for DeepSeek Harness",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./lib/main.js",
  "exports": {
    ".": {
      "types": "./lib/main.d.ts",
      "default": "./lib/main.js"
    },
    "./tool": {
      "types": "./lib/tool-platform.d.ts",
      "default": "./lib/tool-platform.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-subagent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.tests.json && node --test .test-build/tests/runtime.test.js .test-build/tests/tool.test.js .test-build/tests/policy.test.js .test-build/tests/session-env.test.js .test-build/tests/boundaries.test.js",
    "test:real": "tsc -p tsconfig.tests.json && node .test-build/tests/real-muse.js",
    "check": "pnpm run typecheck && pnpm run build && pnpm test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-jobs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@types/node": "^20.19.43",
    "typescript": "5.9.3"
  },
  "types": "./lib/main.d.ts"
}
